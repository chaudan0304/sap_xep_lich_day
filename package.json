{
  "name": "sap-xep-lich-day",
  "productName": "EduTimetable Tiểu Học",
  "description": "Phần mềm Xếp Thời Khóa Biểu Tiểu Học Chuẩn CTGDPT 2018",
  "author": "Châu Đàn",
  "version": "1.0.4",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop:build": "vite build && electron-packager . \"EduTimetable_TieuHoc\" --platform=win32 --arch=x64 --out=dist-desktop --overwrite --prune=true",
    "installer:build": "npm run desktop:build && powershell -Command \"& 'C:\\Users\\chaud\\AppData\\Local\\electron-builder\\cache\\nsis\\nsis-3.0.4.1-nsis-3.0.4.1\\Bin\\makensis.exe' /INPUTCHARSET UTF8 installer.nsi\"",
    "release:zip": "npm run desktop:build && cmd.exe /c \"cd /d dist-desktop\\EduTimetable_TieuHoc-win32-x64 && tar.exe -acf ..\\EduTimetable_TieuHoc_v1.0.4.zip * && copy /y ..\\EduTimetable_TieuHoc_v1.0.4.zip ..\\EduTimetable_TieuHoc.zip\"",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "vite build && electron-builder --win nsis portable",
    "electron:build:installer": "vite build && electron-builder --win nsis",
    "electron:build:portable": "vite build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.edutimetable.tieuhoc",
    "productName": "EduTimetable Tiểu Học",
    "publish": [
      {
        "provider": "github",
        "owner": "chaudan0304",
        "repo": "edutimetable-app"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EduTimetable Tiểu Học"
    }
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^34.5.8",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  }
}
